#!/bin/sh

# small wrapper to launch a suitable BunsenLabs menu for x11 or wayland

# requires jgmenu to be installed
x11_menu() {
    jgmenu_run
}
# requires wtype, and labwc root-menu to be launched by W-Space in rc.xml
wayland_menu() {
    wtype -M logo -k Space
}

check_command() {
    command -v $1 >/dev/null || {
        echo "${0}: ${1} not found" >&2
        exit 1
    }
}

# BUNSEN_SESSION_TYPE is exported by bunsenlabs-session
case $BUNSEN_SESSION_TYPE in
x11)
    check_command jgmenu_run
    menu_function=x11_menu
    ;;
wayland)
    check_command wtype
    menu_function=wayland_menu
    ;;
*)
    echo "${0}: unexpected session type: $BUNSEN_SESSION_TYPE" >&2
    exit 1
    ;;
esac

"$menu_function" || {
    echo "${0}: failed to execute function $menu_function" >&2
    exit 1
}
