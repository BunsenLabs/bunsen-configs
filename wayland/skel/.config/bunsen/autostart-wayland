#######################################################
######## compositor (called "window_manager" here) dependent applications ########
# these could be be things like panels, conky, wallpaper etc

case "$window_manager" in
labwc)
    ## The following applications will only be started in a labwc session.
    ## Add a new clause for your window manager, if different.

