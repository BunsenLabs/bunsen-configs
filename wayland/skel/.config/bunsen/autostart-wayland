    ## The "base" install has no bl-conky-session script, so start conky directly:
    #conky -c ~/.config/conky/BL-Default-conky.conf &

	# set background wallpaper
	xwwall --restore

    ## There is not yet a conky setup for Carbon on Wayland
    ## Start the Conky session (the default conkyrc will run if no sessions have been set)
    #bl-conky-session &

    ## start clipboard if installed
    #type cliphist >/dev/null 2>&1 && wl-paste --watch cliphist store &
    ## now using xfce4-clipman-plugin in xfce4-panel which works on both X11 and Wayland

    ## Start Panel
    xfce4-panel &

    ## start screen lock daemon
    ## unnecessary with xfce4-screensaver?
    ## started by /etc/xdg/autostart/bunsen-exit-xfce4-screensaver.desktop

#    swayidle -w \
#	    timeout 360 'gtklock -d &' \
#	    timeout 720 'wlopm --off \*' \
#	    resume 'wlopm --on \*' \
#       	before-sleep 'gtklock -d &' >/dev/null 2>&1 &

    ;;
    # End of labwc application group.

## clause for sway
#sway)
#    launch something &
#   ;;

## clause for river
#river)
#    launch something different &
#    ;;

esac

####### end of compositor dependent section #######
#######################################################

### Following entries apply to all compositors: ###

## xfce4-power-manager now needs to be explicitly started
xfce4-power-manager &

## Start Clipboard manager
# now using xfce4-clipman-plugin in xfce4-panel

## Start Thunar Daemon, if set as bl-file-manager
(
sleep 2
if [ "$(readlink -f "$(which bl-file-manager)")" = "$(which thunar)" ]
then
    thunar --daemon &
fi
) &

